# PPBF Platform -- LOCAL development environment template.
#
# Copy to apps/web/.env.local and fill in the values. Never commit the filled
# copy: apps/web/.gitignore ignores .env*, and these are live pilot credentials.
#
# WHAT THIS FILE IS
#
# The variables a developer may need on a machine, with values that are safe to
# run locally. It is NOT a report of what staging or production currently
# deploy, and must not be read as one.
#
# This header used to say the `--set-env-vars` block in deploy-staging.yml was
# "the authoritative list of what a RUNNING instance is given" and that this
# file "mirrors it". Both halves were false, in both directions:
#
#   - staging does not set PPBF_PRIMARY_OWNER_EMAIL, which production does set
#     and this file lists, so the staging block was never the whole list;
#   - five of the feature-gate values below were the OPPOSITE of what both
#     deployed environments run, so this file mirrored nothing.
#
# The three postures differ on purpose. A feature gate is off locally, on in
# staging first, and on in production only once staging has proven it. Equal
# values across the three are not the goal -- an UNEXPLAINED difference is the
# finding, so where a difference is real it is stated on the line below.
#
# WHAT KEEPS THIS FILE HONEST
#
# environmentInventory.workflow.test.ts reads the real --set-env-vars blocks in
# deploy-staging.yml and deploy-production.yml and fails when a variable either
# deployment passes to the web Container App has gone missing from here. So the
# NAMES cannot silently fall behind a deployment.
#
# The VALUES here are local defaults and are deliberately not checked against a
# deployment. Where a value drifting actually hurt, a per-variable test pins it
# instead: shadowTokenBudget.workflow.test.ts and
# shadowProviderTimeout.workflow.test.ts.
#
# Values for a pilot machine can be read from the staging Container App:
#   az containerapp secret list --name app-ppbf-staging \
#     --resource-group rg-ppbf-enterprise-staging --show-values -o tsv

# ---------------------------------------------------------------------------
# Required. apps/web/src/server/pilot/env.ts throws at startup without these.
# ---------------------------------------------------------------------------
AZURE_POSTGRES_CONNECTION_STRING=
AZURE_STORAGE_CONNECTION_STRING=

# ---------------------------------------------------------------------------
# Pilot identity and bootstrap.
# ---------------------------------------------------------------------------
PPBF_PILOT_BOOTSTRAP_KEY=
PPBF_PILOT_DEFAULT_ORG_ID=
PPBF_PILOT_SHADOW_CONTAINER=

# The single Microsoft identity permitted to hold platform ownership; both the
# sign-in path and the platform-owner bootstrap resolve it through
# getPrimaryOwnerEmail() in auth.ts. Left unset it falls back to a hardcoded
# address in that function, so a local machine still resolves an owner.
#
# Deployed: production sets it (secretref); staging does NOT, so staging
# validates the code default rather than the identity production enforces.
# That difference is a recorded open finding awaiting an owner decision, not
# one this template may make -- see "Staging is missing PPBF_PRIMARY_OWNER_EMAIL"
# in docs/PLATFORM_AUDIT_2026-07-31_OWNER_DECISIONS.md. It is left as-is here
# deliberately.
PPBF_PRIMARY_OWNER_EMAIL=

# ---------------------------------------------------------------------------
# Microsoft federated login. Only needed to exercise
# /api/pilot/auth/microsoft -- PIN login works without these.
# ---------------------------------------------------------------------------
PPBF_MS_TENANT_ID=
PPBF_MS_CLIENT_ID=
PPBF_MS_CLIENT_SECRET=
PPBF_MS_REDIRECT_URI=
PPBF_MS_POST_LOGIN_PATH=

# ---------------------------------------------------------------------------
# Magic-link sign-in. PPBF_APP_ORIGIN is the origin links are built against
# (e.g. https://localhost:3000 locally). magicLinkStore.ts refuses to send
# without it rather than mail a link pointing at a host that cannot redeem it.
#
# Leave it unset and nothing appears broken: the request route answers "a
# sign-in link is on its way" whatever happens, deliberately, so the endpoint
# cannot be used to discover whether an address belongs to a family at the
# gym. The failure is only visible in the logs, as MISSING_PPBF_APP_ORIGIN.
# Parents and guardians have no other way in, so this is required in every
# environment that real families use.
# ---------------------------------------------------------------------------
PPBF_APP_ORIGIN=

# ---------------------------------------------------------------------------
# SHADOW. Only needed to exercise chat, Library search, or Film Study.
# AZURE_AI_VISION_DEPLOYMENT_NAME is what makes the video content gate real --
# without it the screen cannot run and every upload stays quarantined.
# ---------------------------------------------------------------------------
AZURE_AI_ENDPOINT=
AZURE_AI_DEPLOYMENT_NAME=
AZURE_AI_API_VERSION=
AZURE_AI_KEY=
AZURE_AI_EMBEDDING_DEPLOYMENT_NAME=
AZURE_AI_VISION_DEPLOYMENT_NAME=

# ---------------------------------------------------------------------------
# Runtime tuning and feature gates. Nothing here is a secret.
#
# These are LOCAL values. The two tuning numbers happen to match what both
# environments deploy, and their own tests hold them there. The five gates
# below are deliberately OFF locally and are NOT off in the deployed
# environments -- each line states the deployed posture, read from the
# --set-env-vars blocks in .github/workflows/deploy-{staging,production}.yml.
#
# Changing a value here configures YOUR machine and nothing else. A deployment
# changes only when its workflow changes.
# ---------------------------------------------------------------------------

# Held equal across both environments by shadowTokenBudget.workflow.test.ts,
# above the highest completion count this repository has measured.
PPBF_SHADOW_MAX_COMPLETION_TOKENS=8192
# Held equal across both environments by shadowProviderTimeout.workflow.test.ts,
# above the slowest measured provider round trip.
PPBF_SHADOW_PROVIDER_TIMEOUT_MS=120000

# Off locally so a developer machine runs no background SHADOW drain loop.
# Deployed: staging=true, production=true.
PPBF_SHADOW_WORKER_ENABLED=false

# Off locally: promotion writes real athlete/guardian records.
# Deployed: staging=true, production=true.
PPBF_INTAKE_PROMOTION_ENABLED=false

# Blank locally = no content gate, so local uploads stay quarantined. That is
# the fail-closed direction and is why blank is the safe local value.
# Deployed: staging=vision, production=vision.
PPBF_VIDEO_CONTENT_SCAN=

# Off locally so rate limiting stays in memory and needs no durable table.
# Deployed: staging=true, production=true.
PPBF_DURABLE_RATE_LIMIT=false

# Off locally. Deployed: staging=true, production=NOT SET -- an intentional
# difference, not drift. deploy-staging.yml states the reason: this is the
# admin-only measurement probe for #103, and production leaves it unset "until
# Film Study is a real feature".
PPBF_FILM_STUDY_DIAGNOSTIC_ENABLED=false

# ---------------------------------------------------------------------------
# Research bridge (staging only). Set in deploy-staging.yml's --set-env-vars
# block and read directly by researchBridgeAuth.ts; production leaves these
# unset. isResearchBridgeExportActive() fails closed (returns false) rather
# than throwing when they're missing, so an incomplete local setup degrades
# silently instead of erroring -- worth knowing if the export route seems to
# do nothing.
# ---------------------------------------------------------------------------
RESEARCH_BRIDGE_EXPORT_ENABLED=
RESEARCH_BRIDGE_EXPORT_ENVIRONMENT=
RESEARCH_BRIDGE_EXPORT_ALLOWED_HOST=
RESEARCH_BRIDGE_EXPORT_AUDIENCE=
RESEARCH_BRIDGE_EXPORT_ALLOWED_CLIENT_IDS=
RESEARCH_BRIDGE_ORGANIZATION_ID=
AZURE_TENANT_ID=
