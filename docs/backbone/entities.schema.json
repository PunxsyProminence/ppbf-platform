{
 "x-status_line": "Status: DRAFT, not app source until handoff (RULES.md)",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "ppbf-backbone/entities.schema.json",
 "title": "PPBF training backbone entities (DRAFT)",
 "description": "Status: DRAFT, not app source until handoff (RULES.md). Machine-readable companion to DATA_MODEL.md. Backbone master files are JSON with labelled fields; the repo hand-off is content-package CSV per docs/CONTENT_PACKAGE_CONTRACT.md. Data model (DATA_MODEL.md with this file) approved by Jason at the checkpoint-1 review, 2026-10-24 (D-RV06).",
 "$defs": {
  "status": {
   "enum": [
    "OBSERVED",
    "REPORTED",
    "INFERRED",
    "UNVERIFIED"
   ],
   "description": "RULES.md section 10. Separate from evidence."
  },
  "stage_key": {
   "enum": [
    "Y1",
    "Y2",
    "Y3",
    "Y4",
    "Y5",
    "T1",
    "T2",
    "AM1",
    "AM2",
    "AM3",
    "PR1",
    "PR2",
    "PR3",
    "PR4",
    "PR5",
    "RC1",
    "FT1",
    "EX1"
   ]
  },
  "contact_level": {
   "enum": [
    "none",
    "light_technical",
    "conditioned",
    "controlled_sparring",
    "open_sparring"
   ]
  },
  "sparring_type": {
   "enum": [
    "hard",
    "play",
    "technical",
    "game",
    "conditioned"
   ]
  },
  "evidence_category": {
   "enum": [
    "research",
    "rule",
    "convention",
    "framework",
    "owner_decision",
    "information",
    "unassigned"
   ],
   "description": "EVIDENCE_VOCABULARY.md section 3."
  },
  "evidence_label": {
   "enum": [
    "PROVEN",
    "EMERGING",
    "EXPERIMENTAL",
    "RESEARCH_NEEDED",
    "RULE",
    "CONVENTION",
    "FRAMEWORK",
    "UNTIERED"
   ],
   "description": "What the coach sees. Research tiers come from the repo rule (shadowEvidenceTier.ts) and only after a check."
  },
  "check_state": {
   "enum": [
    "unchecked",
    "verified",
    "corrected",
    "not_found"
   ]
  },
  "labelled": {
   "type": "object",
   "required": [
    "value",
    "status",
    "sources"
   ],
   "properties": {
    "value": {},
    "status": {
     "$ref": "#/$defs/status"
    },
    "sources": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "field_labels": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "status",
     "sources"
    ],
    "properties": {
     "status": {
      "$ref": "#/$defs/status"
     },
     "sources": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   },
   "description": "Per-field status and sources (proposed column field_labels jsonb; PROPOSED_CHANGES SP-1)."
  },
  "evidence_ref": {
   "type": "object",
   "properties": {
    "evidence_category": {
     "$ref": "#/$defs/evidence_category"
    },
    "evidence_label": {
     "$ref": "#/$defs/evidence_label"
    },
    "check_state": {
     "$ref": "#/$defs/check_state"
    },
    "evidence_item_ids": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^evi_[0-9a-f]{14}$"
     }
    },
    "registry_claim_ids": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]-\\d{3}$"
     }
    }
   }
  },
  "record_meta": {
   "type": "object",
   "description": "Fields every backbone record carries.",
   "properties": {
    "organization_id": {
     "type": "string",
     "description": "'{{PPBF_ORG_ID}}' in files (contract rule)."
    },
    "status": {
     "$ref": "#/$defs/status"
    },
    "sources": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "field_labels": {
     "$ref": "#/$defs/field_labels"
    },
    "field_provenance": {
     "type": "string",
     "description": "Repo authoring label (drill_library: 4 allowed values)."
    },
    "source_ref": {
     "type": "string"
    },
    "content_class": {
     "type": "string"
    },
    "backbone_version": {
     "type": "string"
    },
    "active": {
     "type": "boolean"
    },
    "stage_keys": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/stage_key"
     }
    },
    "evidence": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/evidence_ref"
     }
    }
   },
   "required": [
    "status",
    "sources"
   ]
  },
  "versioned": {
   "type": "object",
   "properties": {
    "lineage_id": {
     "type": "string"
    },
    "version": {
     "type": "integer",
     "minimum": 1
    },
    "superseded_at": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "description": "v1 id IS the lineage id; version n>=2 id = prefix + '_' + first 14 hex of sha256(lineage_id + '#v' + n) (repo ids.ts drillVersion rule)."
  },
  "exercise": {
   "description": "A single strength, conditioning or movement exercise. Decided (D-Q19): stored in drill_library with discipline conditioning or general and category 'exercise'; no separate exercise table. Repo: drill_library v3 (reuse).",
   "allOf": [
    {
     "$ref": "#/$defs/record_meta"
    },
    {
     "$ref": "#/$defs/versioned"
    }
   ],
   "type": "object",
   "properties": {
    "drill_id": {
     "type": "string",
     "pattern": "^drl_[0-9a-f]{14}$"
    },
    "name": {
     "type": "string"
    },
    "discipline": {
     "enum": [
      "conditioning",
      "general"
     ]
    },
    "category": {
     "const": "exercise"
    },
    "contact_level": {
     "$ref": "#/$defs/contact_level"
    },
    "assessment_protocol_ids": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "required": [
    "drill_id",
    "name",
    "discipline"
   ]
  },
  "drill": {
   "description": "A coached drill. Repo: drill_library v3 + drill_cues, drill_scale_levels, drill_stop_rules (reuse).",
   "allOf": [
    {
     "$ref": "#/$defs/record_meta"
    },
    {
     "$ref": "#/$defs/versioned"
    }
   ],
   "type": "object",
   "properties": {
    "drill_id": {
     "type": "string",
     "pattern": "^drl_[0-9a-f]{14}$"
    },
    "name": {
     "type": "string"
    },
    "discipline": {
     "type": "string"
    },
    "category": {
     "type": "string"
    },
    "skill_id": {
     "type": "string",
     "pattern": "^SK-[A-Z]+-\\d{2}$"
    },
    "contact_level": {
     "$ref": "#/$defs/contact_level"
    },
    "difficulty": {
     "enum": [
      "beginner",
      "intermediate",
      "advanced",
      "elite"
     ]
    },
    "grounding_claim_ids": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "scorecard_item_ids": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^sci_[0-9a-f]{14}$"
     }
    },
    "supersedes_drill_id": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "required": [
    "drill_id",
    "name",
    "discipline",
    "contact_level"
   ]
  },
  "session": {
   "description": "A session plan (workout template) or a minute-by-minute script. Repo: workout_templates + workout_template_items; session_scripts + session_script_blocks + renderings (reuse; add stage link P9).",
   "allOf": [
    {
     "$ref": "#/$defs/record_meta"
    },
    {
     "$ref": "#/$defs/versioned"
    }
   ],
   "type": "object",
   "properties": {
    "session_kind": {
     "enum": [
      "template",
      "script"
     ]
    },
    "template_id": {
     "type": "string",
     "pattern": "^wtp_[0-9a-f]{14}$"
    },
    "script_id": {
     "type": "string",
     "pattern": "^scr_[0-9a-f]{14}$"
    },
    "name": {
     "type": "string"
    },
    "contact_structure": {
     "enum": [
      "non_contact",
      "contact",
      "split_non_contact_then_contact",
      "observation_only"
     ]
    },
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "item_id": {
        "type": "string",
        "pattern": "^wti_[0-9a-f]{14}$"
       },
       "block_id": {
        "type": "string",
        "pattern": "^blk_[0-9a-f]{14}$"
       },
       "drill_id": {
        "type": "string",
        "pattern": "^drl_[0-9a-f]{14}$"
       },
       "contact_level": {
        "$ref": "#/$defs/contact_level"
       }
      }
     }
    }
   },
   "required": [
    "session_kind",
    "name"
   ]
  },
  "training_block": {
   "description": "An ordered multi-week unit inside a track (not a session_script_block). Repo: NEW pilot.track_blocks; per-athlete instance = athlete_development_blocks + source_track_block_id (PROPOSED_CHANGES SP-9).",
   "allOf": [
    {
     "$ref": "#/$defs/record_meta"
    },
    {
     "$ref": "#/$defs/versioned"
    }
   ],
   "type": "object",
   "properties": {
    "track_block_id": {
     "type": "string",
     "pattern": "^trb_[0-9a-f]{14}$"
    },
    "track_id": {
     "type": "string",
     "pattern": "^trk_[0-9a-f]{14}$"
    },
    "block_order": {
     "type": "integer",
     "minimum": 1
    },
    "title": {
     "type": "string"
    },
    "weeks": {
     "type": "integer",
     "minimum": 1
    },
    "session_refs": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "week": {
        "type": "integer"
       },
       "day": {
        "type": "string"
       },
       "template_id": {
        "type": "string",
        "pattern": "^wtp_[0-9a-f]{14}$"
       },
       "script_id": {
        "type": "string",
        "pattern": "^scr_[0-9a-f]{14}$"
       }
      }
     }
    }
   },
   "required": [
    "track_block_id",
    "track_id",
    "block_order"
   ]
  },
  "program_track": {
   "description": "A named training track or program (e.g. the 8-Week Non-Contact Program as FT1 class track). Repo: NEW pilot.training_tracks; enrollment groups stay in programs/program_memberships.",
   "allOf": [
    {
     "$ref": "#/$defs/record_meta"
    },
    {
     "$ref": "#/$defs/versioned"
    }
   ],
   "type": "object",
   "properties": {
    "track_id": {
     "type": "string",
     "pattern": "^trk_[0-9a-f]{14}$"
    },
    "name": {
     "type": "string"
    },
    "lane": {
     "enum": [
      "standard",
      "non_contact"
     ]
    },
    "track": {
     "enum": [
      "contact",
      "fitness",
      null
     ]
    },
    "duration_weeks": {
     "type": "integer"
    },
    "delivered_to_program_id": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "required": [
    "track_id",
    "name"
   ]
  },
  "assessment_protocol": {
   "description": "A test or rubric. Repo: assessment_protocols (reuse; results in pilot.assessments).",
   "allOf": [
    {
     "$ref": "#/$defs/record_meta"
    }
   ],
   "type": "object",
   "properties": {
    "protocol_id": {
     "type": "string",
     "pattern": "^[A-Z][A-Z0-9]-T\\d{2}$"
    },
    "protocol_version": {
     "type": "integer"
    },
    "name": {
     "type": "string"
    },
    "measure_kind": {
     "enum": [
      "physical_test",
      "skill_rubric",
      "wellness",
      "questionnaire",
      "other"
     ]
    },
    "reliability_status": {
     "type": "string"
    },
    "validity_status": {
     "type": "string"
    },
    "human_authority_required": {
     "type": "boolean"
    }
   },
   "required": [
    "protocol_id",
    "name",
    "measure_kind"
   ]
  },
  "scorecard_item": {
   "description": "One item of a scorecard protocol. Repo: NEW pilot.scorecard_items (P6).",
   "allOf": [
    {
     "$ref": "#/$defs/record_meta"
    }
   ],
   "type": "object",
   "properties": {
    "scorecard_item_id": {
     "type": "string",
     "pattern": "^sci_[0-9a-f]{14}$"
    },
    "protocol_id": {
     "type": "string"
    },
    "item_number": {
     "type": "integer",
     "minimum": 1
    },
    "group": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "definition": {
     "type": "string"
    },
    "scorable_contexts": {
     "type": "array",
     "items": {
      "enum": [
       "drill",
       "shadow",
       "partner",
       "constrained_live",
       "live"
      ]
     }
    }
   },
   "required": [
    "scorecard_item_id",
    "protocol_id",
    "item_number",
    "name"
   ]
  },
  "gate_criterion": {
   "description": "One criterion of a phase gate.",
   "type": "object",
   "properties": {
    "criterion_id": {
     "type": "string",
     "pattern": "^pgc_[0-9a-f]{14}$"
    },
    "ordinal": {
     "type": "integer"
    },
    "kind": {
     "enum": [
      "scorecard_min",
      "stage_completed",
      "gate_met",
      "bout_count",
      "assessment_min",
      "text"
     ]
    },
    "scorecard_item_ids": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^sci_[0-9a-f]{14}$"
     }
    },
    "min_score": {
     "type": "number"
    },
    "contexts": {
     "type": "array"
    },
    "combine": {
     "enum": [
      "all",
      "any"
     ]
    },
    "text": {
     "type": "string"
    }
   },
   "required": [
    "criterion_id",
    "kind"
   ]
  },
  "phase_gate": {
   "description": "Entry, exit or contact-readiness gate of a stage. Informs only; never moves anyone. Repo: NEW pilot.pathway_gates + pathway_gate_criteria (P5).",
   "allOf": [
    {
     "$ref": "#/$defs/record_meta"
    }
   ],
   "type": "object",
   "properties": {
    "gate_id": {
     "type": "string",
     "pattern": "^pgt_[0-9a-f]{14}$"
    },
    "stage_key": {
     "$ref": "#/$defs/stage_key"
    },
    "gate_kind": {
     "enum": [
      "entry",
      "exit",
      "contact_readiness",
      "checkpoint_90_days"
     ],
     "description": "checkpoint_90_days: the T1 90-day check, informs only (D-PK121, PK-121 A, schema P5 change; added 2026-11-10 at the repo handoff step, ACTIONS A-74)."
    },
    "criteria": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/gate_criterion"
     }
    },
    "informs_only": {
     "const": true
    }
   },
   "required": [
    "gate_id",
    "stage_key",
    "gate_kind",
    "criteria"
   ]
  },
  "evidence_item": {
   "description": "One checked statement from one source. Repo: NEW pilot.backbone_evidence_items; research registry claim ids kept as links (SP-10). Carries the six SP-10 provenance fields (source version and access date, support location, population, estimate and uncertainty, limitations, reviewer and date via checked_on); inference class not included (D-PK16). Status 2026-11-10: inference_class added (D-PK12, PK-12 B, reopening D-PK16 on that point; ACTIONS A-74).",
   "allOf": [
    {
     "$ref": "#/$defs/record_meta"
    }
   ],
   "type": "object",
   "properties": {
    "evidence_item_id": {
     "type": "string",
     "pattern": "^evi_[0-9a-f]{14}$"
    },
    "source_key": {
     "type": "string"
    },
    "statement": {
     "type": "string"
    },
    "evidence_category": {
     "$ref": "#/$defs/evidence_category"
    },
    "evidence_class": {
     "type": "string"
    },
    "authority_tier": {
     "type": "integer",
     "minimum": 1,
     "maximum": 5
    },
    "boxing_specificity": {
     "enum": [
      "boxing_specific",
      "partly_boxing_specific",
      "ppbf_specific",
      "transferred"
     ]
    },
    "study_design": {
     "type": "string"
    },
    "synthesis_tag": {
     "enum": [
      "SR/MA",
      "PS",
      "GB",
      "CC",
      "AI-H",
      null
     ]
    },
    "check_state": {
     "$ref": "#/$defs/check_state"
    },
    "checked_on": {
     "type": [
      "string",
      "null"
     ]
    },
    "supports": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "source_version": {
     "type": [
      "string",
      "null"
     ],
     "description": "Document version or edition of the source (SP-10 provenance; D-PK16)."
    },
    "source_accessed_on": {
     "type": [
      "string",
      "null"
     ],
     "description": "Date the source was accessed (SP-10 provenance; D-PK16)."
    },
    "support_location": {
     "type": [
      "string",
      "null"
     ],
     "description": "Section, table or excerpt where the source supports the statement (SP-10 provenance; D-PK16)."
    },
    "population": {
     "type": [
      "string",
      "null"
     ],
     "description": "Population the evidence comes from (SP-10 provenance; D-PK16)."
    },
    "estimate": {
     "type": [
      "string",
      "null"
     ],
     "description": "Reported estimate, only when published or correctly calculated (SP-10 provenance; D-PK16)."
    },
    "uncertainty": {
     "type": [
      "string",
      "null"
     ],
     "description": "Uncertainty of the estimate, for example a confidence interval (SP-10 provenance; D-PK16)."
    },
    "limitations": {
     "type": [
      "string",
      "null"
     ],
     "description": "Limitations and applicability limits (SP-10 provenance; D-PK16)."
    },
    "reviewed_by": {
     "type": [
      "string",
      "null"
     ],
     "description": "Reviewer of the check; the date is checked_on (SP-10 provenance; D-PK16)."
    },
    "inference_class": {
     "enum": [
      "descriptive",
      "associative",
      "causal",
      "theoretical",
      "proposed",
      null
     ],
     "description": "Inference class of the checked claim; values from the Boxing Coach Operational Gaps s4.2 'Claim-level provenance record' (inputs/boxing-coach) (D-PK12)."
    }
   },
   "required": [
    "evidence_item_id",
    "source_key",
    "statement",
    "evidence_category",
    "check_state"
   ]
  },
  "default_rule": {
   "description": "A stage or lane default. Informs; a human may override with a recorded reason. Repo: NEW pilot.pathway_stage_defaults (P7).",
   "allOf": [
    {
     "$ref": "#/$defs/record_meta"
    }
   ],
   "type": "object",
   "properties": {
    "default_id": {
     "type": "string",
     "pattern": "^dft_[0-9a-f]{14}$"
    },
    "scope": {
     "type": "string"
    },
    "default_key": {
     "type": "string"
    },
    "kind": {
     "enum": [
      "default_rule",
      "reference",
      "owner_rule",
      "rule_reference",
      "information"
     ]
    },
    "value_number": {
     "type": "number"
    },
    "value_min": {
     "type": "number"
    },
    "value_max": {
     "type": "number"
    },
    "value_text": {
     "type": "string"
    },
    "unit": {
     "type": "string"
    },
    "window_days": {
     "type": "integer"
    },
    "sparring_type": {
     "type": "string"
    },
    "display_text": {
     "type": "string"
    },
    "evidence_category": {
     "$ref": "#/$defs/evidence_category"
    },
    "override": {
     "type": "object",
     "properties": {
      "allowed": {
       "type": "boolean"
      },
      "who": {
       "type": "array"
      },
      "reason_required": {
       "type": "boolean"
      },
      "extra_condition": {
       "type": "string"
      }
     }
    }
   },
   "required": [
    "default_id",
    "scope",
    "default_key",
    "kind",
    "display_text"
   ]
  },
  "default_override": {
   "description": "A per-athlete override of a default. Repo: NEW pilot.athlete_default_overrides (P7).",
   "allOf": [
    {
     "$ref": "#/$defs/record_meta"
    }
   ],
   "type": "object",
   "properties": {
    "override_id": {
     "type": "string",
     "format": "uuid"
    },
    "athlete_id": {
     "type": "string"
    },
    "default_id": {
     "type": "string",
     "pattern": "^dft_[0-9a-f]{14}$"
    },
    "new_value": {
     "type": "object"
    },
    "reason": {
     "type": "string",
     "minLength": 1
    },
    "set_by_account_id": {
     "type": "string"
    },
    "set_by_role": {
     "enum": [
      "coach",
      "parent",
      "organization_admin",
      "admin"
     ]
    },
    "set_at": {
     "type": "string"
    }
   },
