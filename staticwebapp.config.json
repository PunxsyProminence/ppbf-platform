{
  "routes": [
    {
      "route": "/public*",
      "rewrite": "/public.html"
    },
    {
      "route": "/board",
      "rewrite": "/board.html"
    },
    {
      "route": "/board/president*",
      "rewrite": "/board/president/index.html"
    },
    {
      "route": "/board/chair*",
      "rewrite": "/board/chair/index.html"
    },
    {
      "route": "/board/vice-chair*",
      "rewrite": "/board/vice-chair/index.html"
    },
    {
      "route": "/board/treasurer*",
      "rewrite": "/board/treasurer/index.html"
    },
    {
      "route": "/board/secretary*",
      "rewrite": "/board/secretary/index.html"
    },
    {
      "route": "/board/safety-director*",
      "rewrite": "/board/safety-director/index.html"
    },
    {
      "route": "/board/community-director*",
      "rewrite": "/board/community-director/index.html"
    },
    {
      "route": "/board/at-large*",
      "rewrite": "/board/at-large/index.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["*.{css,scss,js,png,gif,ico,jpg,jpeg,svg,webp,woff,woff2}"]
  }
}

