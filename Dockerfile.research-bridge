FROM node:24-alpine AS dependencies
WORKDIR /app
RUN apk add --no-cache libc6-compat
COPY package.json package-lock.json ./
COPY apps/research-bridge/package.json ./apps/research-bridge/package.json
RUN npm ci --workspace research-bridge --include-workspace-root=false --ignore-scripts

FROM dependencies AS builder
WORKDIR /app
COPY apps/research-bridge/tsconfig.json ./apps/research-bridge/tsconfig.json
COPY apps/research-bridge/src ./apps/research-bridge/src
RUN npm run --workspace research-bridge build

FROM dependencies AS production-dependencies
RUN npm prune --omit=dev --workspace research-bridge --include-workspace-root=false --ignore-scripts

FROM node:24-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

COPY --from=production-dependencies /app/node_modules ./node_modules
COPY --from=production-dependencies /app/package.json ./package.json
COPY --from=production-dependencies /app/apps/research-bridge/package.json ./apps/research-bridge/package.json
COPY --from=builder /app/apps/research-bridge/dist ./apps/research-bridge/dist

USER node
EXPOSE 3000
CMD ["node", "apps/research-bridge/dist/index.js"]
