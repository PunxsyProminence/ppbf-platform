{
  "name": "ppbf-platform",
  "version": "21.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "infra/*"
  ],
  "scripts": {
    "build": "npm run build:web",
    "dev": "echo 'Use: cd apps/web && npm run dev  |  cd apps/coach-review && npm run dev'",
    "dev:web": "cd apps/web && npm run dev",
    "dev:coach": "cd apps/coach-review && npm run dev",
    "install:all": "npm install && cd apps/web && npm install && cd ../../apps/coach-review && npm install",
    "deploy": "firebase deploy --only hosting",
    "build:web": "npm run build --workspace apps/web",
    "build:coach": "npm run build --workspace apps/coach-review"
  },
  "dependencies": {
    "@supabase/auth-helpers-react": "^0.15.0",
    "@supabase/supabase-js": "^2.108.2",
    "lucide-react": "^1.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19"
  },
  "overrides": {
    "postcss": "^8.5.15"
  }
}
