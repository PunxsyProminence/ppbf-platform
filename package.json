{
  "name": "ppbf-platform",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace web run dev --",
    "build": "npm --workspace web run build",
    "start": "npm --workspace web run start --",
    "lint": "npm --workspace web run lint",
    "typecheck": "npm --workspace web run typecheck && npm run typecheck:scripts",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "test": "npm --workspace web run test --",
    "test:migrations": "npm --workspace web run test:migrations --",
    "design:manifest": "node design-system/build-manifest.mjs",
    "shots": "npm --workspace web run shots --",
    "deep:audit": "powershell -ExecutionPolicy Bypass -File ./scripts/deep-audit.ps1",
    "seed:data": "tsx scripts/seed-data.ts",
    "seed:data:dry": "tsx scripts/seed-data.ts --dry-run"
  },
  "devDependencies": {
    "csv-parse": "^7.0.2",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
