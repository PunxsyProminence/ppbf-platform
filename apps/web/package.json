{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node -e \"const path=require('path');const fs=require('fs');const members=['president','chair','vice-chair','treasurer','secretary','safety-director','community-director','at-large'];members.forEach(m=>{const htmlFile=path.join(__dirname,'out','board',m+'.html');const indexDir=path.join(__dirname,'out','board',m);if(fs.existsSync(htmlFile)){fs.mkdirSync(path.join(indexDir),{recursive:true});fs.copyFileSync(htmlFile,path.join(indexDir,'index.html'))}})\"",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
