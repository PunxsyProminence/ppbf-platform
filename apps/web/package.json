{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild-swa.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "pilot:preflight": "node scripts/pilot-preflight.mjs",
    "pilot:apply-schema": "node scripts/pilot-apply-schema.mjs",
    "pilot:apply-multiorg": "node scripts/pilot-apply-multiorg-migration.mjs",
    "pilot:apply-session-expiry": "node scripts/pilot-apply-session-expiry-migration.mjs",
    "pilot:apply-first-login-pin": "node scripts/pilot-apply-first-login-pin-migration.mjs",
    "pilot:apply-audit-event-vocabulary": "node scripts/pilot-apply-audit-event-vocabulary-migration.mjs",
    "pilot:apply-shadow-runtime": "node scripts/pilot-apply-shadow-runtime-migration.mjs",
    "pilot:apply-public-interest": "node scripts/pilot-apply-public-interest-migration.mjs",
    "pilot:apply-scheduler-tables": "node scripts/pilot-apply-scheduler-tables-migration.mjs",
    "pilot:apply-scheduler-race": "node scripts/pilot-apply-scheduler-race-migration.mjs",
    "session:cleanup": "tsx scripts/pilot-cleanup-sessions.ts",
    "seed:shadow:library": "node scripts/seed-shadow-library.mjs",
    "gate:pilot": "node scripts/pilot-gate.mjs",
    "gate:pilot:multiorg": "node scripts/pilot-multiorg-gate.mjs",
    "test": "jest --runInBand --testPathIgnorePatterns=\\.pg\\.test\\.ts$",
    "test:migrations": "npm run test:migrations:session && npm run test:migrations:library && npm run test:migrations:gate",
    "test:migrations:session": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runTestsByPath src/server/pilot/sessionExpiry.migration.pg.test.ts --testTimeout=180000",
    "test:migrations:library": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runTestsByPath src/server/pilot/shadowLibraryPipeline.pg.test.ts --testTimeout=180000",
    "test:migrations:gate": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runTestsByPath src/server/pilot/gateSession.pg.test.ts --testTimeout=180000",
    "gate:pilot:shadow-intake": "node scripts/pilot-shadow-intake-gate.mjs",
    "gate:pilot:shadow-e2e": "node scripts/pilot-shadow-intake-gate.mjs",
    "audit:mock-ingest": "tsx scripts/run-mock-ingest.ts",
    "test:e2e:board": "playwright test e2e/board-governance.spec.ts",
    "test:e2e:board:update": "playwright test e2e/board-governance.spec.ts --update-snapshots",
    "test:e2e:homepage": "playwright test e2e/public-homepage.spec.ts",
    "test:e2e:homepage:update": "playwright test e2e/public-homepage.spec.ts --update-snapshots"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.28.0",
    "googleapis": "^173.0.0",
    "next": "16.2.9",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "pg": "^8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
